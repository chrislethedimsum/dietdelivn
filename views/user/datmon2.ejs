<form action="/user/datmon" method="POST">
  <% if (userOrdersInWeek && userOrdersInWeek.length > 0) { %>
    <div style="background: #e0ffe0; border: 1px solid green; padding: 10px; margin-bottom: 20px;">
      Bạn đã đặt món cho tuần này. Bạn có thể thay đổi hoặc hủy món cho những ngày còn trong hạn.
    </div>
  <% } else { %>
    <div style="background: #fffbe0; border: 1px solid orange; padding: 10px; margin-bottom: 20px;">
      Bạn chưa đặt món cho tuần này. Hãy chọn món trước <strong>12:00 trưa Chủ nhật</strong>.
    </div>
  <% } %>

  <table border="1" cellpadding="6">
    <tr>
      <th>Ngày</th>
      <th>Trạng thái</th>
      <th>Slot 1</th>
      <th>Slot 2</th>
    </tr>
<%
const orderMap = {};
if (userOrdersInWeek) {
  userOrdersInWeek.forEach(o => {
    const mealDateFormatted = moment(o.meal_date).format("YYYY-MM-DD");
    orderMap[mealDateFormatted] = o;
  });
}

days.forEach((day, idx) => { 
     const mealDate = dayDates[idx];
     const mealDateObj = new Date(mealDate);
     let disabled = "";
     let note = "";
     const packageStart = new Date(user_package.start_date);
     const packageEnd = new Date(user_package.end_date);
     if (mealDateObj < packageStart) {
       disabled = "disabled data-originally-disabled='1'";
       note = "(Gói ăn của bạn chưa bắt đầu vào ngày này)";
     } else if (mealDateObj > packageEnd) {
       disabled = "disabled data-originally-disabled='1'";
       note = "(Gói ăn của bạn đã hết hạn vào ngày này)";
     } else {
       if (!(now >= allowedStart && now <= allowedEnd)) {
         const cutoff = new Date(mealDate);
         cutoff.setDate(cutoff.getDate() - 1);
         cutoff.setHours(12, 0, 0, 0);
         if (now > cutoff) {
           disabled = "disabled data-originally-disabled='1'";
           note = "(Hết hạn đặt)";
         }
       }
     }
     const userOrder = orderMap[mealDate];
%>
  <tr>
    <td>
      <%= day %> (<%= mealDateObj.toLocaleDateString('vi-VN') %>)
    </td>
    <td>
      <% if (note) { %>
        <span style="color:red;" title="<%= note %>">⚠️</span>
      <% } %>
      <% if (userOrder) {%>
        
  <% if (userOrder.status == 'ordered') { %>
    <div style="color: green;"><strong>Đã đặt</strong></div>
  <% } else if (userOrder.status == 'canceled') { %>
    <div style="color: orange;">Đã hủy đặt nhưng có thể đặt lại</div>
  <% } else if (userOrder.status == 'delivered') { %>
    <div style="color: blue;">Đã giao</div>
    <% } %>
<% } else if (!disabled) { %>
  <div style="color: orange;">Chưa đặt</div>
<% } else { %>
  <div style="color: gray;">Không khả dụng</div>
<% } %>
    </td>
    <% if (meals_per_day == 1) { %>
      <td>
        <% if (menuByDay[day][1]) { %>
          <input type="radio" name="orders[<%= mealDate %>]" value="<%= mealDate %>|1|<%= menuByDay[day][1].meal_id %>" <%= disabled %>
            <% if (userOrder && (userOrder.status == "ordered" || userOrder.status == "delivered") && userOrder.selected_slot == "1" && userOrder.selected_meal_slot1 == menuByDay[day][1].meal_id) { %>checked<% } %>
          >
          <%= menuByDay[day][1].meal_name %>
        <% } %>
        </td><td>
        <% if (menuByDay[day][2]) { %>
          <input type="radio" name="orders[<%= mealDate %>]" value="<%= mealDate %>|2|<%= menuByDay[day][2].meal_id %>" <%= disabled %>
            <% if (userOrder && (userOrder.status == "ordered" || userOrder.status == "delivered") && userOrder.selected_slot == "2" && userOrder.selected_meal_slot2 == menuByDay[day][2].meal_id) { %>checked<% } %>
          >
          <%= menuByDay[day][2].meal_name %>
        <% } %>
      </td>
    <% } else { %>
      <td colspan="2">
        <% if (menuByDay[day][1] && menuByDay[day][2]) { %>
          <input type="checkbox" name="orders[]" value="<%= mealDate %>|both|<%= menuByDay[day][1].meal_id %>|<%= menuByDay[day][2].meal_id %>" <%= disabled %>
            <% if (userOrder && (userOrder.status == "ordered" || userOrder.status == "delivered") && userOrder.selected_slot == "both" && userOrder.selected_meal_slot1 == menuByDay[day][1].meal_id && userOrder.selected_meal_slot2 == menuByDay[day][2].meal_id) { %>checked<% } %>
          >
          <%= menuByDay[day][1].meal_name %> + <%= menuByDay[day][2].meal_name %>
        <% } else { %>
          Không có đủ 2 món
        <% } %>
      </td>
    <% } %>
  </tr>
<% }) %>
  </table>
  <input type="hidden" name="user_package_id" value="<%= user_package_id %>">
  <% if (userOrdersInWeek && userOrdersInWeek.length > 0) { %>
    <button type="submit">Cập nhật món đã đặt</button>
  <% } else { %>
    <button type="submit">Đặt món ngay</button>
  <% } %>
</form>
<script>
  const maxDays = <%= remaining_days %>;
  const form = document.querySelector('form');
  const checkboxes = form.querySelectorAll('input[type="checkbox"][name^="orders"]');
  const radios = form.querySelectorAll('input[type="radio"][name^="orders"]');

  function updateLimit() {
    let checkedCount = 0;
    if (checkboxes.length > 0) {
      checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
      checkboxes.forEach(cb => {
        if (!cb.checked && checkedCount >= maxDays && !cb.hasAttribute('data-originally-disabled')) {
          cb.disabled = true;
        } else if (!cb.hasAttribute('data-originally-disabled')) {
          cb.disabled = false;
        }
      });
    } else if (radios.length > 0) {
      const days = {};
      radios.forEach(radio => {
        if (radio.checked) days[radio.name] = true;
      });
      checkedCount = Object.keys(days).length;
      radios.forEach(radio => {
        if (!radio.checked && checkedCount >= maxDays && !radio.hasAttribute('data-originally-disabled')) {
          radio.disabled = true;
        } else if (!radio.hasAttribute('data-originally-disabled')) {
          radio.disabled = false;
        }
      });
    }
  }

  if (checkboxes.length > 0) {
    checkboxes.forEach(cb => cb.addEventListener('change', updateLimit));
  }
  if (radios.length > 0) {
    radios.forEach(radio => radio.addEventListener('change', updateLimit));
  }
  updateLimit();
</script>

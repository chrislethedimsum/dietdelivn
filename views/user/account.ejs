<%- include('../includes/header.ejs') %>
    <!-- Start Page -->
    <div class="page-start section-ptb">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 pe-3">
                    <div class="sidebar-wrapper">
                        <!-- Start Chef Widget -->
                        <div class="author-widget custom-border p-4 mb-5 p-sm-3">
                            <div class="author-info text-center mt-3">
                                <div class="widget-text">
                                    <p class="mb-0">Xin chào, <h6 class="heading-6 text-hover"><%= user.name %></h6></p>
                                    <p class="mb-0 custom-botder-bottom">Email: <%= user.email %></p>
                                    <p class="mb-0 custom-botder-bottom">Số điện thoại: <%= user.phone %></p>
                                    <p class="mb-0 custom-botder-bottom">Địa chỉ: <%= user.address %></p>
                                    <p class="mb-0 custom-botder-bottom">Tuổi: <%= user.age %> tuổi</p>
                                    <p class="mb-0 custom-botder-bottom">Chiều cao: <%= user.height %> cm</p>
                                    <p class="mb-0 custom-botder-bottom">Cân nặng: <%= user.weight %> kg</p>
                                    <p class="mb-0 custom-botder-bottom">Giới tính: <%= user.gender %></p>
                                    <p class="mb-0 custom-botder-bottom">Mục tiêu: <%= user.goal %></p>
                                    <a href="/user/info-edit/<%= user.id %>" class="default-btn-alt mt-3"> <i class="fas fa-pencil-alt"></i> Sửa thông tin</a>
                                </div>
                            </div>
                        </div>
                        <!-- End Chefr Widget -->
                         <!-- Start Chef Widget -->
                        <div class="author-widget mb-5">
                            <center><a href="/user/datmon" class="very-big-btn"> <i class="fas fa-utensils"></i> Đặt món ăn</a></center>
                        </div>
                        <!-- End Chefr Widget -->
                         <!-- Start Cateogiries Widget -->
                        <div class="categories-widget mb-5 custom-border p-4 p-sm-3">
                            <div class="widget-title-2">
                                <h4 class="heading-4">Gói ăn hiện tại</h4>
                            </div>
                            <% if (user_package) { %>
                                <div class="widget-nav mt-3">
                                    <ul>
                                        <li>Gói: <%= meal_package.name %></li>
                                        <li>Loại: <%= meal_package.meals_per_day %> bữa/ngày <%= meal_package.calories_per_meal %> kcal</li>
                                        <li>Số bữa ăn còn lại: <%= user_package.remaining_meals %></li>
                                        <li>Thời gian bắt đầu: <%= moment(user_package.start_date).format("DD/MM/YYYY") %></li>
                                        <li>Thời gian kết thúc: <%= moment(user_package.end_date).format("DD/MM/YYYY") %></li>
                                    </ul>
                                </div>
                            <% } else { %>
                                <div class="widget-nav mt-3">
                                    <ul>
                                        <li>Bạn chưa có hoặc đã hết gói ăn. Liên hệ bọn mình để tư vấn hoặc gia hạn nhé.</li>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                        <!-- End Cateogiries Widget -->
                        <!-- Start Cateogiries Widget -->
                        <div class="categories-widget mb-5 custom-border p-4 p-sm-3">
                            <div class="widget-title-2">
                                <h4 class="heading-4">Theo dõi tiến trình</h4>
                            </div>
                            <img src="/images/track_progress.jpg" alt="Track Progress" class="img-fluid mt-3 mb-3" />
                        </div>
                        <!-- End Cateogiries Widget -->
                        <!-- Start Cateogiries Widget -->
                        <div class="categories-widget mb-5 custom-border p-4 p-sm-3">
                            <div class="widget-title-2">
                                <h4 class="heading-4">Mục lục</h4>
                            </div>
                            <div class="widget-nav mt-3">
                                <ul>
                                    <li><a href="#"><i class="fas fa-angle-right"></i>Hóa đơn</a></li>
                                </ul>
                            </div>
                        </div>
                        <!-- End Cateogiries Widget -->
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="section-title-3 mb-4">
                        <h2 class="heading-2">Thông tin đặt món tuần này</h2>
                    </div>
                    <div class="table-responsive overflow-hidden custom-round custom-border mb-3">
                    <table class="table table-bordered" style="margin-bottom: 0;">
                        <thead class="table-light">
                            <tr>
                                <th>Thứ</th>
                                <th>Món đã chọn</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const day of structuredWeek) { %>
                            <tr>
                                <td><%= capitaliseVN(day.weekday) %></td>
                                <td>
                                <% if (day.meals) { %>
                                    <ul class="mb-0">
                                    <% day.meals.forEach(meal => { %>
                                        <li><i class="fas fa-utensils text-success"></i> <%= meal %></li>
                                    <% }) %>
                                    </ul>
                                <% } else { %>
                                    <span class="text-muted"><i class="fas fa-times-circle text-danger"></i> Chưa chọn món</span>
                                <% } %>
                                </td>
                                <td>
                                <% if (day.outsidePackageStart) { %>
                                    <span class="badge bg-info text-dark"><i class="fas fa-hourglass-start"></i> Gói ăn chưa có hiệu lực</span>
                                <% } else if (day.outsidePackageEnd) { %>
                                    <span class="badge bg-secondary"><i class="fas fa-hourglass-end"></i> Gói ăn đã hết hiệu lực</span>
                                <% } else if (day.status === "ordered") { %>
                                    <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Đã đặt</span>
                                <% } else if (day.status === "delivered") { %>
                                    <span class="badge bg-success"><i class="fas fa-check-circle"></i> Đã giao</span>
                                <% } else if (day.status === "canceled") { %>
                                    <span class="badge bg-danger"><i class="fas fa-ban"></i> Đã hủy</span>
                                <% } else { %>
                                    <span class="badge bg-light text-muted"><i class="fas fa-minus-circle"></i> Không có</span>
                                <% } %>
                                </td>
                                <td>
                                <% if (day.outsidePackageStart || day.outsidePackageEnd) { %>
                                    <i class="fas fa-lock text-muted"></i> Không áp dụng gói ăn
                                <% } else if (day.canEdit) { %>
                                    <a href="/user/datmon"><i class="fas fa-edit text-primary"></i> Có thể đặt món</a>
                                <% } else { %>
                                    <i class="fas fa-lock text-muted"></i> Đã khóa chỉnh sửa
                                <% } %>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                    </div>
                   <div class="all-orders">
                    <div class="section-title-3 mb-5">
                        <h2 class="heading-2">Các tuần đã đặt</h2>
                    </div>
                    <% if (weeks_data && weeks_data.length > 0) { %>
                        <% for (const week of weeks_data) { %>
                        <div class="orders-history mb-5">
                            <div class="single-order d-flex align-items-center custom-border p-3">
                                <div class="order-content">
                                    <h5 class="heading-5">
                                    Tuần bắt đầu <%= moment(week.week_start_date).format('DD/MM/YYYY') %>
                                    </h5>
                                    <div class="order-info mt-2">
                                    <p>
                                        <i class="fas fa-drumstick-bite text-primary"></i>
                                        Đã giao: <strong><%= week.delivered_meals %> / <%= week.total_valid_meals %></strong> bữa
                                    </p>
                                    <% if (week.meal_names && week.meal_names.length > 0) { %>
                                        <p>
                                            <i class="fas fa-concierge-bell text-info"></i>
                                            Các món đã giao: 
                                            <%= week.meal_names.join(", ") %>
                                        </p>
                                    <% } %>
                                    <% if (week.ordered_weekdays && week.ordered_weekdays.length > 0) { %>
                                        <p>
                                            <i class="fas fa-calendar-day text-success"></i>
                                            Các thứ đã đặt: 
                                            <%= capitaliseVN(week.ordered_weekdays.join(", ")) %>
                                        </p>
                                    <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    <% } else { %>
                        <div class="section-title-3 mb-5 text-center">
                        <p class="heading-2">Bạn chưa đặt tuần nào</p>
                        </div>
                    <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Page -->

    <!-- Start Subscribe Area -->
    <div class="subscribe-area section-ptb-2" style="background-image: url(/images/action_bg.jpg);">
        <div class="container">
            <div class="row align-items-center">
            </div>
        </div>
    </div>
    <!-- End Subscribe Area -->
<%- include('../includes/footer.ejs') %>
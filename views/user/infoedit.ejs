<%- include('../includes/header.ejs') %>
    <!-- Start Product Details -->
    <div class="product-details section-ptb">
        <div class="container">
            <div class="table-responsive overflow-hidden custom-round custom-border mb-3">
                <form action="/user/info-edit/<%= user.id %>" method="POST">
                <table class="table table-bordered" style="margin-bottom: 0;">
                    <tbody>
                        <tr>
                            <td>Tên</td>
                            <td><%= user.name %></td>
                        </tr>
                        <tr>
                            <td>Email</td>
                            <td><input class="form-control" type="email" id="email" name="email" value="<%= user.email %>"></td>
                        </tr>
                        <tr>
                            <td>Số điện thoại</td>
                            <td><input class="form-control" type="number" id="phone" name="phone" value="<%= user.phone %>"></td>
                        </tr>
                        <tr>
                            <td>Địa chỉ</td>
                            <td><input class="form-control" type="text" id="address" name="address" value="<%= user.address %>"></td>
                        </tr>
                        <tr>
                            <td>Mật khẩu</td>
                            <td><input class="form-control" type="password" id="password" name="password" value="<%= user.password %>"></td>
                        </tr>
                        <tr>
                            <td>Nhập lại mật khẩu</td>
                            <td><input class="form-control" type="password" id="repassword" name="repassword" placeholder="Hãy nhập lại mật khẩu khi và chỉ khi thay đổi mật khẩu"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-center">
                    <button class="default-btn" type="submit">Cập nhật thông tin</button>
            </div>
            </form>
        </div>
    </div>
    <!-- End Product Details -->

    <!-- Start Subscribe Area -->
    <div class="subscribe-area section-ptb-2" style="background-image: url(/images/action_bg.jpg);">
    </div>
    <!-- End Subscribe Area -->
    <script>
        document.querySelector('.default-btn')?.addEventListener('click', async (e) => {
            e.preventDefault();

            const email = document.getElementById("email").value;
            const phone = document.getElementById("phone").value;
            const address = document.getElementById("address").value;
            const password = document.getElementById("password").value;
            const repassword = document.getElementById("repassword").value;

            if (!email || !phone || !address || !password) {
                Swal.fire("Error", "Vui lòng điền đầy đủ thông tin");
                return;
            }

            const { isConfirmed } = await Swal.fire({
                title: "Bạn có chắc chắn muốn cập nhật thông tin không?",
                text: "Thông tin sẽ được cập nhật ngay lập tức.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Cập nhật",
                cancelButtonText: "Hủy",
              });

            if (!isConfirmed) return;

            try {
              const res = await fetch("/user/info-edit/<%= user.id %>", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email: email,
                    phone: phone,
                    address: address,
                    password: password,
                    repassword: repassword
                })
              });

              const result = await res.json();
              if (result.success) {
                Swal.fire("Cập nhật thông tin thành công", "Sẽ tự động về trang Tài Khoản").then(() => {
                  window.location.href = "/user/account";
                });
              } else {
                Swal.fire("Cập nhật thông tin bị lỗi!", result.message || "Vui lòng thử lại sau hoặc liên hệ quản trị viên.");
              }
            } catch (err) {
              console.error("Lỗi gửi cart:", err);
              alert("Không thể kết nối máy chủ.");
            }
        });
    </script>
<%- include('../includes/footer.ejs') %>
<!-- prettier-ignore -->
<% const nowMoment = moment.tz(now.format(), "Asia/Ho_Chi_Minh"); %>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />
        <title>Menu - Diet Deli</title>
        <link rel="icon" type="image/png" href="/images/favicon.png" />
        <link rel="stylesheet" href="/css/bootstrap.min.css" />
        <link rel="stylesheet" href="/css/owl.carousel.min.css" />
        <link rel="stylesheet" href="/css/all.min.css" />
        <link rel="stylesheet" href="/css/aos.css" />
        <link rel="stylesheet" href="/css/jquery.fancybox.min.css" />
        <link rel="stylesheet" href="/css/nouislider.min.css" />
        <link rel="stylesheet" href="/css/nice-select.css" />
        <link rel="stylesheet" href="/css/style.css" />
        <style>
            .widget-nav ul li a.active {
                color: #fe771c;
                padding-left: 10px;
            }
            .fade-in {
              opacity: 0;
              transition: opacity 1s ease-in-out;
            }

            .fade-in.visible {
              opacity: 1;
            }
        </style>
    </head>

    <body>
        <div class="page-wrapper section-ptb">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-12 order-lg-1 order-1">
                        <aside class="sidebar-wrapper">
                            <!-- Start Cateogiries Widget -->
                            <div class="categories-widget mb-4 custom-border p-4">
                                <div class="widget-title-2">
                                    <h4 class="heading-4">Menu (tuần <%= moment(weekStartStr).format("DD/MM/YYYY") %>)</h4>
                                </div>
                                <div class="widget-nav mt-3">
                                    <ul>
                                      <% days.forEach((dayName, index) => { 
                                        const meals = menuByDay[dayName]; 
                                        if (!meals) return;

                                        const actualDate = moment(weekStartStr).add(index, 'days');
                                        const formattedDate = actualDate.format("DD/MM/YYYY");
                                        const actualDateStr = actualDate.format("YYYY-MM-DD");

                                        const isAvailable = availableDays.find(d => d.date === actualDateStr);
                                      %>
                                        <li>
                                          <% if (isAvailable) { %>
                                          <a
                                            href="javascript:void(0);"
                                            onclick="showMeals('<%= dayName %>', '<%= formattedDate %>', this)"
                                          >
                                            <i class="fas fa-angle-right"></i>
                                            Thứ <%= index + 2 %> (<%= formattedDate %>)
                                          </a>
                                          <% } else { %>
                                          <span class="text-muted">
                                            <i class="fas fa-angle-right"></i>
                                            Thứ <%= index + 2 %> (<%= formattedDate %>)
                                          </span>
                                          <% } %>
                                        </li>
                                      <% }); %>
                                    </ul>
                                </div>
                            </div>
                            <!-- End Cateogiries Widget -->
                        </aside>
                    </div>
                    <div class="col-lg-8 col-md-12 order-lg-2 order-2">
                        <!-- Start Sorting Form -->
                        <div class="shorting-form d-flex justify-content-between bg-semi-white align-items-center p-4">
                            <div class="filter-info">
                                <p>Các ngày đã được đặt: <strong>Chưa có</strong></p>
                            </div>
                            <div class="filter-form">
                                <p>
                                    Tổng bữa đã chọn trong tuần:
                                    <strong id="total-meals-week">0</strong>
                                </p>
                            </div>
                        </div>

                        <div class="all-products mt-5">
                            <div class="products-wrapper">
                                <div id="meal-container" class="row"></div>
                            </div>
                        </div>
                        <!-- End Products -->
                    </div>
                </div>
                <div class="search-widget mb-4 py-5 py-sm-4 px-4 custom-round" style="background-image: url(/images/action_bg.jpg)">
                    <center>
                        <div class="input-wrapper input-btn">
                            <button type="submit" class="default-btn">ĐẶT NGAY</button>
                        </div>
                    </center>
                </div>
            </div>
        </div>
        <!-- End Start -->

        <!-- Start Subscribe Area -->
        <div class="subscribe-area section-ptb-2" style="background-image: url(/images/action_bg.jpg)"></div>
        <!-- End Subscribe Area -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
        <script>
          const menuByDay = <%- JSON.stringify(menuByDay) %>;
          const dayDates = <%- JSON.stringify(dayDates) %>;
          const mealsPerDay = <%= meals_per_day %>;
          const days = <%- JSON.stringify(days) %>;
          const userPackageId = <%= user_package_id %>;
          const availableDays = <%- JSON.stringify(availableDays) %>;
          let cart = <%- JSON.stringify(cartFromDb || []) %>;
          console.log("Cart loaded from DB:", cart);
          if (!cart) {
            console.log("Cart is empty, initializing as an empty array.");
          }

          function showMeals(dayName, dateStr, el = null, withFade = true) {
            const container = document.getElementById('meal-container');
            if (!container) return;

            if (withFade) {
              container.classList.remove('fade-in', 'visible');
              container.style.opacity = 0;
            }

            let html = '';
            const dayMeals = menuByDay[dayName];
            if (!dayMeals) return;

            // Highlight ngày đang chọn
            document.querySelectorAll('.widget-nav ul li a').forEach(a => a.classList.remove('active'));
            if (el) el.classList.add('active');

            const daySelectedEl = document.getElementById('day-selected');
            if (daySelectedEl) {
              daySelectedEl.textContent = `${dayName} (${dateStr})`;
            }

            const dayISO = moment(dateStr, "DD/MM/YYYY", true).isValid()
              ? moment(dateStr, "DD/MM/YYYY").format("YYYY-MM-DD")
              : moment(dateStr).format("YYYY-MM-DD");

            if (mealsPerDay === 1) {
              ['1', '2'].forEach(slot => {
                const meal = dayMeals[slot];
                if (!meal) return;

                const isSelected = cart.find(item => item.day === dayISO && item.slot == slot);
                const buttonText = isSelected ? "Xóa" : "Chọn";
                const buttonClass = isSelected ? "btn-danger" : "btn-success";

                html += `
                  <div class="col-lg-6 col-sm-6">
                    <div class="card border-0 product-card custom-round">
                      <div class="card-thumb">
                        <img src="${meal.meal_image}" class="card-img-top" alt="food" />
                        <button class="btn btn-sm ${buttonClass}" onclick="toggleMeal('${dayName}', '${dateStr}', ${slot}, '${meal.meal_name}', '${meal.meal_id}')">
                          <i class="fas fa-${isSelected ? 'times' : 'plus'}"></i> ${buttonText}
                        </button>
                      </div>
                      <div class="card-body">
                        <h6 class="heading-6">${meal.meal_name}</h6>
                        <div class="card-meta d-flex py-2">
                          <div class="product-price pl-4">
                            <span class="a">Thông tin: </span>
                            <span class="b">${meal.meal_description}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>`;
              });
            } else {
              ['1', '2'].forEach(slot => {
                const meal = dayMeals[slot];
                if (!meal) return;

                const isSelected = cart.find(item => item.day === dayISO && item.slot == slot);
                const buttonText = isSelected ? "Xóa" : "Chọn";
                const buttonClass = isSelected ? "btn-danger" : "btn-success";

                html += `
                  <div class="col-lg-6 col-sm-6">
                    <div class="card border-0 product-card custom-round">
                      <div class="card-thumb">
                        <img src="${meal.meal_image}" class="card-img-top" alt="food" />
                        <button class="btn btn-sm ${buttonClass}" onclick="toggleMeal('${dayName}', '${dateStr}', ${slot}, '${meal.meal_name}', '${meal.meal_id}')">
                          <i class="fas fa-${isSelected ? 'times' : 'plus'}"></i> ${buttonText}
                        </button>
                      </div>
                      <div class="card-body">
                        <h6 class="heading-6">${meal.meal_name}</h6>
                        <div class="card-meta d-flex py-2">
                          <div class="product-price pl-4">
                            <span class="a">Thông tin: </span>
                            <span class="b">${meal.meal_description}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>`;
              });

              // Tính trạng thái "Chọn cả ngày"
              const slot1Selected = cart.find(item => item.day === dayISO && item.slot == 1);
              const slot2Selected = cart.find(item => item.day === dayISO && item.slot == 2);
              const bothSelected = slot1Selected && slot2Selected;

              const bothButtonText = bothSelected ? "Xóa cả ngày" : "Chọn cả ngày";
              const bothButtonClass = bothSelected ? "btn-danger" : "btn-success";

              html += `
                <div class="col-12 text-center mt-3 mb-3">
                  <button class="btn ${bothButtonClass}" onclick="toggleFullDay('${dayName}', '${dateStr}')">
                    ${bothButtonText}
                  </button>
                </div>`;
            }

            // Gán nội dung rồi delay hiệu ứng
            container.innerHTML = html;

            if (withFade) {
              requestAnimationFrame(() => {
                container.classList.add('fade-in');
                requestAnimationFrame(() => {
                  container.classList.add('visible');
                  container.style.opacity = 1;
                });
              });
            }

            updateSummary();
          }


          document.querySelectorAll('.choose-day-btn').forEach(btn => {
              btn.addEventListener('click', () => {
                const date = btn.getAttribute('data-date');

                if (mealsPerDay === 2) {
                  const index = cart.findIndex(item => item.day === date);
                  if (index >= 0) {
                    cart.splice(index, 1); // Đã chọn rồi → hủy
                    btn.textContent = 'Chọn ngày ăn';
                    btn.classList.remove('active');
                  } else {
                    cart.push({ day: date }); // Thêm ngày mới
                    btn.textContent = 'Xóa ngày ăn';
                    btn.classList.add('active');
                  }
                }

                updateSummary(); // Cập nhật lại phần tóm tắt
              });
            });
          
          function toggleMeal(dayName, day, slot, name, meal_id) {
            let dayISO = moment(day, "DD/MM/YYYY", true).isValid()
              ? moment(day, "DD/MM/YYYY").format("YYYY-MM-DD")
              : moment(day).format("YYYY-MM-DD");

            if (mealsPerDay === 1) {
              // Logic cũ giữ nguyên
              const existingIndex = cart.findIndex(item => item.day === dayISO && item.slot == slot);

              if (existingIndex !== -1) {
                cart.splice(existingIndex, 1);
              } else {
                cart = cart.filter(item => item.day !== dayISO); // chỉ 1 slot/ngày
                cart.push({ day: dayISO, slot, name, meal_id });
              }
            } else {
              // Cho phép chọn từng slot độc lập
              const existingIndex = cart.findIndex(item => item.day === dayISO && item.slot == slot);
              if (existingIndex !== -1) {
                cart.splice(existingIndex, 1); // Bỏ chọn slot
              } else {
                cart.push({ day: dayISO, slot, name, meal_id });
              }
            }

            console.table(cart);
            const formattedDate = moment(dayISO, "YYYY-MM-DD").format("DD/MM/YYYY");
            showMeals(dayName, formattedDate, null, false);
          }


          // Với user có meals_per_day = 2
          function toggleFullDay(dayName, day) {
            const dayISO = moment(day, "DD/MM/YYYY", true).isValid()
              ? moment(day, "DD/MM/YYYY").format("YYYY-MM-DD")
              : moment(day).format("YYYY-MM-DD");

            const hasSlot1 = cart.find(item => item.day === dayISO && item.slot === 1);
            const hasSlot2 = cart.find(item => item.day === dayISO && item.slot === 2);

            if (hasSlot1 && hasSlot2) {
              // Đã chọn cả ngày → xóa hết
              cart = cart.filter(item => !(item.day === dayISO && (item.slot === 1 || item.slot === 2)));
            } else {
              const dayMeals = menuByDay[dayName];
              if (!dayMeals) return;

              ['1', '2'].forEach(slot => {
                const meal = dayMeals[slot];
                if (meal && !cart.find(item => item.day === dayISO && item.slot === parseInt(slot))) {
                  cart.push({
                    day: dayISO,
                    slot: parseInt(slot),
                    name: meal.meal_name,
                    meal_id: meal.meal_id,
                    image: meal.meal_image,
                    description: meal.meal_description
                  });
                }
              });
            }

            console.table(cart);
            const formattedDate = moment(dayISO, "YYYY-MM-DD").format("DD/MM/YYYY");
            showMeals(dayName, formattedDate, null, false);
          }


          // Toggle chọn ngày ăn cả ngày        
          function updateSummary() {
            const totalElement = document.getElementById('total-meals-week');
            const infoElement = document.querySelector('.filter-info p');

            if (!totalElement || !infoElement) return;

            let selectedDays = [];

            if (mealsPerDay === 1) {
              selectedDays = [...new Set(cart.map(item => item.day))];
            } else {
              // Nếu mỗi item là { day }, map thẳng ra mảng ngày
              selectedDays = [...new Set(cart.map(item => item.day))];
            }

            // Render thông tin ngày đã chọn
            const dateText = selectedDays.map(date => {
              const index = dayDates.indexOf(date);
              if (index === -1) return null;
              return `Thứ ${index + 2} (${date})`;
            }).filter(Boolean).join(", ");

            infoElement.innerHTML = `Các ngày đã được đặt: <strong>${dateText || "Chưa có"}</strong>`;
            totalElement.textContent = cart.reduce((sum, item) => sum + (item.meals ? item.meals.length : 1), 0);
          }

          document.addEventListener('DOMContentLoaded', () => {
            if (!availableDays || availableDays.length === 0) return;
            const dayName = availableDays[0].name;
            const dateStr = availableDays[0].date;

            showMeals(dayName, dateStr);

            const formattedDateStr = moment(dateStr, "YYYY-MM-DD").format("DD/MM/YYYY");
            document.querySelectorAll('.widget-nav ul li a').forEach(link => {
              if (link.innerText.includes(formattedDateStr)) {
                link.classList.add('active');
              }
            });
          });

          //Post đặt món
          document.querySelector('.default-btn')?.addEventListener('click', async (e) => {
            e.preventDefault();

            // Cho phép cart rỗng — nghĩa là user muốn hủy tất cả các ngày
            if (cart.length === 0) {
              const { isConfirmed } = await Swal.fire({
                title: "Bạn đang hủy tất cả các ngày ăn trong tuần?",
                text: "Thao tác này sẽ xóa tất cả các món đã đặt trong tuần này.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Đúng, hủy tất cả",
                cancelButtonText: "Không",
              });

              if (!isConfirmed) return;
            }

            const cartToSend = cart.map(item => {
              if (item.meals) {
                return {
                  day: item.day,
                  meals: item.meals.map(m => ({
                    slot: m.slot,
                    meal_id: m.meal_id
                  }))
                };
              } else {
                return {
                  day: item.day,
                  slot: item.slot,
                  meal_id: item.meal_id
                };
              }
            });
              console.log("Cart to send:", cartToSend);
            try {
              const res = await fetch("/user/datmon", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({
                  user_package_id: userPackageId,
                  cart: cartToSend
                })
              });

              const result = await res.json();
              if (res.ok) {
                Swal.fire("Đặt món thành công, bây giờ cùng quay lại tài khoản để kiểm tra nhé", "success").then(() => {
                  window.location.href = "/user/account";
                });
              } else {
                Swal.fire("Đặt món thất bại! Liên hệ với chúng mình để kiểm tra nhé!", "error");
              }
            } catch (err) {
              console.error("Lỗi gửi cart:", err);
              alert("Không thể kết nối máy chủ.");
            }
          });
        </script>

        <script src="/js/jquery-3.7.1.min.js" type="text/javascript"></script>
        <script src="/js/bootstrap.bundle.min.js" type="text/javascript"></script>
        <script src="/js/aos.js" type="text/javascript"></script>
        <script src="/js/owl.carousel.min.js" type="text/javascript"></script>
        <script src="/js/jquery.fancybox.min.js" type="text/javascript"></script>
        <script src="/js/jquery.waypoints.min.js" type="text/javascript"></script>
        <script src="/js/jquery.counterup.min.js" type="text/javascript"></script>
        <script src="/js/jquery.scrollUp.min.js" type="text/javascript"></script>
        <script src="/js/jquery.nice-select.min.js" type="text/javascript"></script>
        <script src="/js/nouislider.min.js" type="text/javascript"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="/js/main.js" type="text/javascript"></script>
    </body>
</html>

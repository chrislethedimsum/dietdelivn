<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title><%= pageTitle %> - Diet Deli</title>
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="/css/all.min.css" />
    <link rel="stylesheet" href="/css/aos.css" />
    <link rel="stylesheet" href="/css/jquery.fancybox.min.css" />
    <link rel="stylesheet" href="/css/nice-select.css" />
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
    <div class="container">
        <a href="/admin/monan" class="default-btn">Xem món</a>
        <form class="border mt-4 p-5 rounded" action="/admin/<% if (editing) { %>suamonan<% } else { %>themmonan<% } %>" method="POST">
            <div class="mb-3">
                <label for="name" class="form-label text-dark">Tên món ăn</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="Nhập tên món ăn" value="<%= editing ? monan.name : '' %>">
            </div>
            <div class="mb-3">
                <label for="image" class="form-label text-dark">Hình ảnh món ăn</label>
                <input type="text" class="form-control" id="image" name="image" placeholder="Nhập đường link hình ảnh" value="<%= editing ? monan.image : '' %>">
            </div>
            <div class="mb-3">
                <label for="description" class="form-label text-dark">Thông tin về món ăn</label>
                <input type="text" class="form-control" id="description" name="description" placeholder="Nhập thông tin món ăn" value="<%= editing ? monan.description : '' %>">
            </div>
            <div class="mb-3">  
                <label for="servingsize" class="form-label text-dark">Serving size</label>
                <input type="text" class="form-control" id="servingsize" name="servingsize"  placeholder="Nhập serving size" value="<%= editing ? monan.servingsize : '' %>">
            </div>
            <div class="mb-3">
                <label for="carb" class="form-label text-dark">Carb</label>
                <input type="text" class="form-control" id="carb" name="carb" placeholder="Nhập carb" value="<%= editing ? monan.carb : '' %>">
            </div>
            <div class="mb-3">
                <label for="protein" class="form-label text-dark">Protein</label>
                <input type="text" class="form-control" id="protein" name="protein" placeholder="Nhập protein" value="<%= editing ? monan.protein : '' %>">
            </div>
            <div class="mb-3">
                <label for="fat" class="form-label text-dark">Fat</label>
                <input type="text" class="form-control" id="fat" name="fat" placeholder="Nhập fat" value="<%= editing ? monan.fat : '' %>">
            </div>
            <% if (editing) { %>
                <input type="hidden" value="<%= monan.id %>" name="monId">
            <% } %>
            <div class="text-center">
                <button class="default-btn" type="submit"><% if (editing) { %>Cập nhật món ăn<% } else { %>Thêm món ăn <% } %></button>
            </div>
        </form>
    </div>
    <script src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script src="/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="/js/aos.js" type="text/javascript"></script>
    <script src="/js/owl.carousel.min.js" type="text/javascript"></script>
    <script src="/js/jquery.fancybox.min.js" type="text/javascript"></script>
    <script src="/js/jquery.waypoints.min.js" type="text/javascript"></script>
    <script src="/js/jquery.counterup.min.js" type="text/javascript"></script>
    <script src="/js/jquery.scrollUp.min.js" type="text/javascript"></script>
    <script src="/js/jquery.nice-select.min.js" type="text/javascript"></script>
    <script src="/js/nouislider.min.js" type="text/javascript"></script>
    <script src="/js/main.js" type="text/javascript"></script>
</body>
</html>

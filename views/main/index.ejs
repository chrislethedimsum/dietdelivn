<%- include('../includes/index-header.ejs') %>

<!-- Start Here Area -->
<div class="hero-area-wrapper">
  <!-- <div class="hero-bg" style="background-image: url('/images/here_slider.png');"></div> -->
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 col-md-6 order-md-1">
        <div class="popular-posts-wrapper owl-carousel hero-carousel">
          <img src="/images/food.png" class="img-fluid" alt="hero-slider" />
          <img src="/images/food.png" class="img-fluid" alt="hero-slider" />
        </div>
      </div>
      <div class="col-lg-6 col-md-6">
        <div class="here-content">
          <h1 class="heading-one">Ăn Kiêng Thật Dễ Dàng</h1>
          <p>
            Chúng tôi mang đến một giải pháp ăn kiêng khoa học, từng suất ăn
            được tinh chỉnh phù hợp với nhu cầu khách hàng.
          </p>
          <form class="location-form" id="tuvansdt">
            <div class="form-content">
              <div class="input-wrapper">
                <div class="need-support">Cần tư vấn?</div>
              </div>
              <div class="input-wrapper">
                <i class="fas fa-phone"></i>
                <input
                  type="number"
                  id="sdt"
                  name="sdt"
                  class="form-control pl-4"
                  placeholder="Số liên hệ Zalo"
                />
              </div>

              <div class="input-wrapper input-btn">
                <button type="submit" class="default-btn">Nhận tư vấn</button>
                </div>
              </div>
            </div>
          </form>
        </div>
        <!-- Content End  -->
      </div>
    </div>
  </div>
</div>
<!-- End Here Area -->

<!-- Start Order Step -->
<div class="order-step-area section-ptb">
  <div class="container">
    <div class="row">
      <div class="col-md-8 mx-auto mb-5 mb-xs-0">
        <div class="section-title text-center">
          <h2 class="heading-2-extra">4 bước đặt hàng</h2>
        </div>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-lg-3 col-sm-6 text-center px-0">
        <div class="single-step pt-5">
          <h6 class="heading-6">Nhận tư vấn khẩu phần</h6>
          <img src="/images/step_01.png" alt="step one" class="" />
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 text-center px-0">
        <div class="single-step">
          <img src="/images/step_02.png" alt="step two" class="pb-5" />
          <h6 class="heading-6">Chọn bữa ăn hàng tuần</h6>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 text-center px-0">
        <div class="single-step pt-5">
          <h6 class="heading-6">Thanh toán</h6>
          <img src="/images/step_03.png" alt="step one" class="pt-5" />
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 text-center px-0">
        <div class="single-step">
          <img src="/images/step_04.png" alt="step two" class="pb-5" />
          <h6 class="heading-6">Thưởng thức suất ăn</h6>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- End Order Step -->

